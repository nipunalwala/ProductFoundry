# Copy to .env and fill in. .env is never committed.

# Local database (docker-compose.yml). These defaults are for local use only.
POSTGRES_USER=productfoundry
POSTGRES_PASSWORD=productfoundry
POSTGRES_DB=productfoundry
POSTGRES_PORT=5433

# Job queue (phase 13). The API on the host reaches Redis on this port.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
# true: the worker and the API run every stage as a stand-in, with no outside request.
FAKE_STAGES=false
# Reviews the worker fetches per product per store in one run.
REVIEW_CAP=2000

# LLM providers (phase 3)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Web search for competitor discovery (phase 4): https://tavily.com
TAVILY_API_KEY=

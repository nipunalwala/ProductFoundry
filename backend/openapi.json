{
  "components": {
    "schemas": {
      "Approve": {
        "additionalProperties": false,
        "description": "Approve the checkpoint as it is, with a whole edited output, or with edits.",
        "properties": {
          "competitors": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompetitorEdits"
              },
              {
                "type": "null"
              }
            ]
          },
          "edited_output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Output"
          },
          "pain_points": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PainPointEdits"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "Approve",
        "type": "object"
      },
      "CompetitorEdits": {
        "additionalProperties": false,
        "properties": {
          "add": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Add",
            "type": "array"
          },
          "remove": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Remove",
            "type": "array"
          }
        },
        "title": "CompetitorEdits",
        "type": "object"
      },
      "CreateRun": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "$ref": "#/components/schemas/RunInput"
          },
          "seed": {
            "default": 0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "input"
        ],
        "title": "CreateRun",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Incumbent": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "store_ids": {
            "$ref": "#/components/schemas/StoreIds",
            "default": {}

        "required": [
          "key",
          "status",
          "schema_version",
          "edited",
          "output",
          "original_output"
        ],
        "title": "StageOutputView",
        "type": "object"
      },
      "StageStatus": {
        "enum": [
          "pending",
          "running",
          "awaiting_approval",
          "failed",
          "completed"
        ],
        "title": "StageStatus",
        "type": "string"
      },
      "StageView": {
        "properties": {
          "approved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          },
          "checkpoint": {
            "title": "Checkpoint",
            "type": "boolean"
          },
          "edited": {
            "title": "Edited",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "has_output": {
            "title": "Has Output",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"

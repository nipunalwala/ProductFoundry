          "urls": {
            "default": [],
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "title": "Incumbent",
        "type": "object"
      },
      "Mode": {
        "enum": [
          "new_idea",
          "alternative",
          "new_feature"
        ],
        "title": "Mode",
        "type": "string"
      },
      "PainPointEdits": {
        "additionalProperties": false,
        "description": "Pain points are named by their rank in the stage's output, or by cluster id.",
        "properties": {
          "drop": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Drop",
            "type": "array"
          },
          "merge": {
            "default": [],
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Merge",
            "type": "array"
          },
          "rank": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Rank",
            "type": "array"
          },
          "rename": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Rename",
            "type": "object"
          }
        },
        "title": "PainPointEdits",
        "type": "object"
      },
      "Platform": {
        "enum": [
          "android",
          "ios",
          "web"
        ],
        "title": "Platform",
        "type": "string"
      },
      "Problem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Resume": {
        "additionalProperties": false,
        "properties": {
          "from_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Stage"
          }
        },
        "title": "Resume",
        "type": "object"
      },
      "RunInput": {
        "additionalProperties": false,
        "properties": {
          "idea": {
            "minLength": 1,
            "title": "Idea",
            "type": "string"
          },
          "incumbent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Incumbent"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_competitors": {
            "default": [],
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Known Competitors",
            "type": "array"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/Platform"
            },
            "minItems": 1,
            "title": "Platforms",
            "type": "array"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "target_users": {
            "minLength": 1,
            "title": "Target Users",
            "type": "string"
          },
          "tech_stack": {
            "default": [],
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Tech Stack",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "idea",
          "target_users",
          "platforms",
          "region"
        ],
        "title": "RunInput",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "pending",
          "running",
          "awaiting_approval",
          "paused_quota",
          "failed",
          "completed"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "idea": {
            "title": "Idea",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "idea",
          "created_at",
          "updated_at"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "RunView": {
        "properties": {
          "awaiting_approval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Awaiting Approval"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "idea": {
            "title": "Idea",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/RunInput"
          },
          "pause_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pause Reason"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageView"
            },
            "title": "Stages",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "idea",
          "created_at",
          "updated_at",
          "input",
          "seed",
          "error",
          "pause_reason",
          "awaiting_approval",
          "stages"
        ],
        "title": "RunView",
        "type": "object"
      },
      "StageOutputView": {
        "properties": {
          "edited": {
            "title": "Edited",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "original_output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Output"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"

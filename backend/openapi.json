        "type": "object"
      },
      "StoreIds": {
        "additionalProperties": false,
        "properties": {
          "app_store": {
            "anyOf": [
              {
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Store"
          },
          "google_play": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Google Play"
          }
        },
